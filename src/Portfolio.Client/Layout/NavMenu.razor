<button class="nav-toggle"
        type="button"
        aria-label="Toggle navigation"
        aria-expanded="@(_expanded ? "true" : "false")"
        aria-controls="primary-nav"
        @onclick="ToggleNav">
    <span class="nav-toggle-bar"></span>
    <span class="nav-toggle-bar"></span>
    <span class="nav-toggle-bar"></span>
</button>

<nav id="primary-nav" class="nav @(_expanded ? "is-open" : "")" aria-label="Primary">
    @foreach (var item in Items)
    {
        <a class="nav-link" href="@item.Href" @onclick="CloseNav">@item.Label</a>
    }
</nav>

@code {
    private bool _expanded;

    private static readonly NavItem[] Items =
    [
        new("#about", "About"),
        new("#projects", "Projects"),
        new("#certificates", "Certificates"),
        new("#contact", "Contact")
    ];

    private void ToggleNav() => _expanded = !_expanded;

    // Anchor navigation does not unmount the layout, so the mobile menu has to
    // be closed explicitly or it stays open over the target section.
    private void CloseNav() => _expanded = false;

    private sealed record NavItem(string Href, string Label);
}
