<button class="nav-toggle"
        type="button"
        aria-label="Toggle navigation"
        aria-expanded="@(_expanded ? "true" : "false")"
        aria-controls="primary-nav"
        @ref="_toggle"
        @onclick="ToggleNav"
        @onkeydown="CloseOnEscapeAsync">
    <span class="nav-toggle-bar"></span>
    <span class="nav-toggle-bar"></span>
    <span class="nav-toggle-bar"></span>
</button>

<nav id="primary-nav" class="nav @(_expanded ? "is-open" : "")" aria-label="Primary" @onkeydown="CloseOnEscapeAsync">
    @foreach (var item in Items)
    {
        <a class="nav-link" href="@item.Href" @onclick="CloseNav">@item.Label</a>
    }
</nav>

@code {
    private bool _expanded;
    private ElementReference _toggle;

    private static readonly NavItem[] Items =
    [
        new("#about", "About"),
        new("#projects", "Projects"),
        new("#certificates", "Certificates"),
        new("#contact", "Contact")
    ];

    private void ToggleNav() => _expanded = !_expanded;

    // Anchor navigation does not unmount the layout, so the mobile menu has to
    // be closed explicitly or it stays open over the target section.
    private void CloseNav() => _expanded = false;

    // Escape closes the open menu, the expected way out of a disclosure. Focus goes
    // back to the toggle, since the link it was on is about to be hidden.
    private async Task CloseOnEscapeAsync(KeyboardEventArgs e)
    {
        if (!_expanded || e.Key != "Escape")
        {
            return;
        }

        _expanded = false;
        await _toggle.FocusAsync();
    }

    private sealed record NavItem(string Href, string Label);
}
