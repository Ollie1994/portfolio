@*
    Shared shell for every project detail page. Takes the accent as a CSS class
    rather than a colour value so pages cannot introduce a fifth accent - the
    four Microsoft logo colours are the whole set. See CLAUDE.md.

    Everything above the body comes from the project's entry in ProjectCatalog, which
    the home page's card reads too. The entry is the one whose page is at this address,
    so a page only needs its @page route and its body.
*@
@inject NavigationManager Navigation

<PageTitle>@Project.Title — Oliwer Karlsson</PageTitle>

<article class="project @Project.AccentClass">
    <header class="project-header">
        <div class="container">
            <a class="back-link" href="/#projects">← All projects</a>

            <p class="project-eyebrow">@Project.Kicker</p>
            <h1>@Project.Title</h1>
            <p class="project-summary">@Detail.Summary</p>

            <ul class="tech-list" aria-label="Technologies used">
                @foreach (var tech in Detail.Tech)
                {
                    <li class="tech-pill">@tech</li>
                }
            </ul>

            @if (Detail.Links.Count > 0)
            {
                <div class="project-links">
                    @foreach (var link in Detail.Links)
                    {
                        <a class="btn btn-secondary" href="@link.Href" rel="noopener">@link.Label</a>
                    }
                </div>
            }
        </div>
    </header>

    <hr class="ms-rule" />

    <div class="container project-body">
        @ChildContent
    </div>

    <div class="container project-footer">
        <a class="btn btn-primary" href="/#contact">Get in touch</a>
        <a class="btn btn-secondary" href="/#projects">All projects</a>
    </div>
</article>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // Found from the address rather than passed in, so a page cannot show another
    // project's header. A page with no entry is a programming error, not input, so it
    // throws; ProjectCatalogTests checks that every /projects/ route has one. Looking
    // through five entries on each access costs nothing worth caching.
    private Project Project
    {
        get
        {
            var path = new Uri(Navigation.Uri).AbsolutePath;
            return ProjectCatalog.ForPath(path)
                ?? throw new InvalidOperationException($"No project in ProjectCatalog has its page at {path}.");
        }
    }

    // ForPath matches on the page's address, so a match always has page details.
    private ProjectDetail Detail =>
        Project.Detail ?? throw new InvalidOperationException($"{Project.Title} has no page details in ProjectCatalog.");
}
