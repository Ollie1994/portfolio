@if (Href is null)
{
    <div class="card @AccentClass">@Content</div>
}
else
{
    <a class="card @AccentClass" href="@Href">@Content</a>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Kicker { get; set; } = string.Empty;

    /// <summary>accent-red / accent-green / accent-blue / accent-yellow, or
    /// accent-neutral for a project with nothing to show yet.</summary>
    [Parameter, EditorRequired] public string AccentClass { get; set; } = "accent-blue";

    // Required but nullable: a card without these has to say so, so leaving one out
    // by mistake still fails the build.
    [Parameter, EditorRequired] public string? Summary { get; set; }

    /// <summary>The project's page. When null the card is plain content: not a
    /// link, not focusable, no hover effect.</summary>
    [Parameter, EditorRequired] public string? Href { get; set; }

    [Parameter] public IReadOnlyList<string> Tech { get; set; } = [];

    private RenderFragment Content => @<text>
        <span class="card-kicker">@Kicker</span>
        <h3 class="card-title">@Title</h3>
        @if (Summary is not null)
        {
            <p class="card-summary">@Summary</p>
        }

        <span class="card-tech">
            @foreach (var tech in Tech)
            {
                <span class="tech-pill">@tech</span>
            }
        </span>

        @if (Href is not null)
        {
            <span class="card-more" aria-hidden="true">Read more →</span>
        }
    </text>;
}
