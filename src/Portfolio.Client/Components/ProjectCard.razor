@*
    The link is the title alone, so its name is the project's name. When the whole card
    was the link, a screen reader read the kicker, title, summary and every tech pill as
    one link. The title link's ::after stretches over the card, so the whole card is
    still clickable - see ProjectCard.razor.css.

    A project without a page (Href null) is plain content: no link, not focusable, no
    hover effect.
*@
<div class="card @Project.AccentClass @(Project.Href is null ? null : "card-has-link")">
    <span class="card-kicker">@Project.Kicker</span>
    <h3 class="card-title">
        @if (Project.Href is null)
        {
            @Project.Title
        }
        else
        {
            <a class="card-title-link" href="@Project.Href">@Project.Title</a>
        }
    </h3>
    @if (Project.CardSummary is not null)
    {
        <p class="card-summary">@Project.CardSummary</p>
    }

    <span class="card-tech">
        @foreach (var tech in Project.CardTech)
        {
            <span class="tech-pill">@tech</span>
        }
    </span>

    @if (Project.Href is not null)
    {
        <span class="card-more" aria-hidden="true">Read more →</span>
    }
</div>

@code {
    // null! only until Blazor sets it: EditorRequired makes leaving it out a build
    // error, and a component parameter cannot use the required keyword.
    [Parameter, EditorRequired] public Project Project { get; set; } = null!;
}
