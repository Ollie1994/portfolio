@using Portfolio.Client.Services
@using Portfolio.Shared
@using Portfolio.Shared.Contact
@inject ContactApiClient Contacts

@if (_sent)
{
    <div class="form-success" role="status">
        <h3 tabindex="-1" @ref="_sentHeading">Message sent</h3>
        <p>Thanks for getting in touch — I'll reply to @_sentTo as soon as I can.</p>
        <button type="button" class="btn btn-secondary" @onclick="Reset">Send another</button>
    </div>
}
else
{
    @* novalidate: otherwise the browser's own check on type="email" blocks the submit
       first and shows its popup, so a mistyped address never got the form's message
       or focus handling, while an empty field did.

       aria-required rather than required on the fields: it tells a screen reader the
       field is required before anything is submitted, and changes nothing else about how
       the browser treats the field. Everything else about validation is the form's own.
       The visible note below says the same to everyone else. *@
    <form class="contact-form" novalidate @onsubmit="SubmitAsync" @onsubmit:preventDefault>

        @if (_failed)
        {
            <p class="form-error" role="alert">
                Something went wrong sending that. Please try again in a moment.
            </p>
        }

        <p class="form-note">All fields are required.</p>

        <div class="field">
            <label for="contact-name">Name</label>
            <input id="contact-name"
                   type="text"
                   maxlength="@ContactLimits.NameMaxLength"
                   autocomplete="name"
                   aria-required="true"
                   aria-describedby="@(ErrorFor(nameof(ContactRequest.Name)) is null ? null : "contact-name-error")"
                   aria-invalid="@AriaInvalid(nameof(ContactRequest.Name))"
                   @ref="_nameInput"
                   @bind="_name"
                   @bind:event="oninput" />
            @if (ErrorFor(nameof(ContactRequest.Name)) is { } nameError)
            {
                <p id="contact-name-error" class="field-error">@nameError</p>
            }
        </div>

        <div class="field">
            <label for="contact-email">Email</label>
            <input id="contact-email"
                   type="email"
                   maxlength="@ContactLimits.EmailMaxLength"
                   autocomplete="email"
                   aria-required="true"
                   aria-describedby="@(ErrorFor(nameof(ContactRequest.Email)) is null ? null : "contact-email-error")"
                   aria-invalid="@AriaInvalid(nameof(ContactRequest.Email))"
                   @ref="_emailInput"
                   @bind="_email"
                   @bind:event="oninput" />
            @if (ErrorFor(nameof(ContactRequest.Email)) is { } emailError)
            {
                <p id="contact-email-error" class="field-error">@emailError</p>
            }
        </div>

        <div class="field">
            <label for="contact-message">Message</label>
            <textarea id="contact-message"
                      rows="6"
                      maxlength="@ContactLimits.MessageMaxLength"
                      aria-required="true"
                      aria-describedby="@(ErrorFor(nameof(ContactRequest.Message)) is null ? "" : "contact-message-error ")contact-message-count"
                      aria-invalid="@AriaInvalid(nameof(ContactRequest.Message))"
                      @ref="_messageInput"
                      @bind="_message"
                      @bind:event="oninput"></textarea>
            @* The error first, directly under the field, as for Name and Email; the counter
               after it. Read in the same order. *@
            @if (ErrorFor(nameof(ContactRequest.Message)) is { } messageError)
            {
                <p id="contact-message-error" class="field-error">@messageError</p>
            }
            <p id="contact-message-count" class="field-hint">
                @_message.Length / @ContactLimits.MessageMaxLength
            </p>
        </div>

        @* Honeypot. Hidden from people; a bot that fills in every field fills this too.
           aria-hidden and tabindex keep it out of the way of screen readers and keyboard
           users.

           Anything that fills it for a person loses their message: the API discards it
           and still says it was sent. So it is named so autofill has nothing to match.
           It used to be "Website", a field browsers and password managers know, and the
           bots it is for fill every field whatever its name. The data- attributes are
           each password manager's own opt-out: data-1p-ignore is in 1Password's developer
           docs; data-lpignore (LastPass), data-bwignore (Bitwarden) and data-form-type
           (Dashlane) are as their help and community pages describe, unverified here.
           autocomplete="off" alone does not stop them. *@
        <div class="honeypot" aria-hidden="true">
            <label for="contact-leave-empty">Leave this empty</label>
            <input id="contact-leave-empty"
                   type="text"
                   tabindex="-1"
                   autocomplete="off"
                   data-1p-ignore
                   data-lpignore="true"
                   data-bwignore="true"
                   data-form-type="other"
                   @bind="_website" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@_sending" @ref="_submitButton">
            @(_sending ? "Sending…" : "Send message")
        </button>

        <p class="privacy-note">
            Your name, email address and message are stored in this site's application
            logs so I can read and reply to them, and are deleted automatically after
            30 days. They aren't shared with anyone or used for anything else.
        </p>
    </form>
}

@code {
    private string _name = string.Empty;
    private string _email = string.Empty;
    private string _message = string.Empty;
    private string _website = string.Empty;

    private bool _sending;
    private bool _sent;
    private bool _failed;
    private string _sentTo = string.Empty;
    private IReadOnlyList<ValidationError> _errors = [];

    private ElementReference _nameInput;
    private ElementReference _emailInput;
    private ElementReference _messageInput;
    private ElementReference _submitButton;
    private ElementReference _sentHeading;

    // Where focus goes once the next render is in the DOM. Without it, errors appear
    // with focus still on the button and nothing read out, and after sending focus
    // drops to the page body: the button is disabled while sending, which takes
    // focus off it, and on success it is gone altogether.
    private FocusTarget _focusAfterRender;

    private enum FocusTarget
    {
        None,

        /// <summary>Its label and error are read out, via aria-describedby.</summary>
        FirstInvalidField,

        /// <summary>After a failure, so trying again is one key press. The error
        /// itself is announced by its role="alert".</summary>
        SubmitButton,

        SentHeading,
        NameField
    }

    private string? ErrorFor(string field) =>
        _errors.FirstOrDefault(e => e.Field == field)?.Message;

    // A string, not a bool: Blazor renders true as an empty attribute, and
    // aria-invalid="" means the field is valid.
    private string AriaInvalid(string field) =>
        ErrorFor(field) is null ? "false" : "true";

    private async Task SubmitAsync()
    {
        if (_sending)
        {
            return;
        }

        _failed = false;

        var request = new ContactRequest
        {
            Name = _name,
            Email = _email,
            Message = _message,
            Website = _website
        };

        // Client-side validation is for immediate feedback only. The API runs the
        // same rules and its answer is the authoritative one.
        var validation = ContactValidator.Validate(request);
        if (!validation.IsValid)
        {
            _errors = validation.Errors;
            _focusAfterRender = FocusTarget.FirstInvalidField;
            return;
        }

        _errors = [];
        _sending = true;

        try
        {
            var result = await Contacts.SendAsync(request);

            switch (result.Status)
            {
                case ContactSendStatus.Sent:
                    _sentTo = request.Email;
                    _sent = true;
                    _focusAfterRender = FocusTarget.SentHeading;
                    break;

                case ContactSendStatus.Invalid:
                    _errors = result.Errors;

                    // Errors only show beside a field. If none of these names one of
                    // ours with a message - client and server out of step, say - the
                    // form would change nothing, so it is reported as a failure.
                    if (FirstInvalidField() is null)
                    {
                        _errors = [];
                        _failed = true;
                        _focusAfterRender = FocusTarget.SubmitButton;
                    }
                    else
                    {
                        _focusAfterRender = FocusTarget.FirstInvalidField;
                    }

                    break;

                default:
                    _failed = true;
                    _focusAfterRender = FocusTarget.SubmitButton;
                    break;
            }
        }
        finally
        {
            _sending = false;
        }
    }

    private void Reset()
    {
        _name = _email = _message = _website = string.Empty;
        _errors = [];
        _sent = false;
        _failed = false;
        _focusAfterRender = FocusTarget.NameField;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var target = _focusAfterRender;
        _focusAfterRender = FocusTarget.None;

        ElementReference? element = target switch
        {
            FocusTarget.FirstInvalidField => FirstInvalidField(),
            FocusTarget.SubmitButton => _submitButton,
            FocusTarget.SentHeading => _sentHeading,
            FocusTarget.NameField => _nameInput,
            _ => null
        };

        if (element is { } focusable)
        {
            await focusable.FocusAsync();
        }
    }

    // In the order the fields appear, so focus never skips backwards past an error.
    private ElementReference? FirstInvalidField() =>
        ErrorFor(nameof(ContactRequest.Name)) is not null ? _nameInput
        : ErrorFor(nameof(ContactRequest.Email)) is not null ? _emailInput
        : ErrorFor(nameof(ContactRequest.Message)) is not null ? _messageInput
        : null;
}
