@page "/"
@using Portfolio.Client.Components

<PageTitle>Oliwer Karlsson — Software Developer</PageTitle>

<section class="hero">
    <div class="container">
        <p class="eyebrow">Software Developer</p>
        <h1>Oliwer Karlsson</h1>
        <p class="lead">
            I build things on the Microsoft stack — C#, .NET and Azure.
            This site is one of them: Blazor WebAssembly on the front, Azure Functions
