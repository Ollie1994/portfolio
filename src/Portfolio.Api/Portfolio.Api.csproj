<Project Sdk="Microsoft.NET.Sdk">

  <!-- Nullable, ImplicitUsings and analyzer settings come from
       Directory.Build.props. Package versions come from Directory.Packages.props.
       TargetFramework must stay here - Azure's Oryx builder text-scans csproj
       files for it and cannot see inherited MSBuild properties. It must also
       match apiRuntime in staticwebapp.config.json. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Portfolio.Shared\Portfolio.Shared.csproj" />
  </ItemGroup>

</Project>
