<Project Sdk="Microsoft.NET.Sdk">

  <!-- Nullable, ImplicitUsings and analyzer settings come from
       Directory.Build.props. Package versions come from Directory.Packages.props. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- ProjectCatalogTests checks the published sitemap against the catalogue. -->
    <None Include="..\..\src\Portfolio.Client\wwwroot\sitemap.xml" Link="sitemap.xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- SubmissionTraceTests reads the submissions query from it. -->
    <None Include="..\..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Portfolio.Shared\Portfolio.Shared.csproj" />
    <ProjectReference Include="..\..\src\Portfolio.Api\Portfolio.Api.csproj" />
    <ProjectReference Include="..\..\src\Portfolio.Client\Portfolio.Client.csproj" />
  </ItemGroup>

</Project>
