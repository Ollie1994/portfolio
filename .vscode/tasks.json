{
    "version": "2.0.0",
    "tasks": [
        {
            // No command of its own, so each server that is not running is started.
            // In sequence because client and api both build Portfolio.Shared, and
            // building it twice at once fails now and then with a locked file.
            "label": "site",
            "dependsOn": ["client", "api", "emulator"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "client",
            "type": "shell",
            "command": "dotnet watch --project src/Portfolio.Client run",
            "options": {
                // The launch configuration opens the browser, on :4280.
                "env": { "DOTNET_WATCH_SUPPRESS_LAUNCH_BROWSER": "1" }
            },
            "isBackground": true,
            "presentation": { "group": "site" },
            "problemMatcher": {
                "base": "$msCompile",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "dotnet watch .* Building",
                    // The last two are a failed build: dotnet watch stays alive
                    // and waits, so without them F5 would wait too.
                    "endsPattern": "Now listening on|Exited with error code|Waiting for a file to change"
                }
            }
        },
        {
            "label": "api",
            "type": "shell",
            "command": "func start --port 7071",
            "options": { "cwd": "${workspaceFolder}/src/Portfolio.Api" },
            "isBackground": true,
            "presentation": { "group": "site" },
            "problemMatcher": {
                "base": "$msCompile",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Determining projects to restore",
                    "endsPattern": "For detailed output, run func with"
                }
            }
        },
        {
            // Points at the running API rather than letting the SWA CLI start it:
            // the CLI only does that on Node 18 to 22.
            "label": "emulator",
            "type": "shell",
            "command": "swa start --api-devserver-url http://localhost:7071",
            "isBackground": true,
            "presentation": { "group": "site" },
            "problemMatcher": {
                "pattern": { "regexp": "^$", "file": 1, "location": 2, "message": 3 },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Welcome to Azure Static Web Apps CLI",
                    "endsPattern": "emulator started at"
                }
            }
        }
    ]
}
