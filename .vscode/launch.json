{
    "version": "0.2.0",
    "configurations": [
        {
            // The whole site on one origin, as in production: client, API and the
            // Static Web Apps routing in front. The servers keep running when the
            // browser closes, and F5 starts whichever are not running.
            //
            // The client picks up edits by itself. The API does not: after changing
            // Portfolio.Api or Portfolio.Shared, run "Tasks: Restart Running Task"
            // and choose "api".
            "name": "Site (localhost:4280)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:4280",
            "preLaunchTask": "site"
        }
    ]
}
